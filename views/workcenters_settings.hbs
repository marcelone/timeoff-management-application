{{> header }}

<div class="row">
  <div class="col-md-12">
    <h1>Work centres</h1>
    <p class="lead">
      A work centre can have its own time zone. When it is left empty, the centre
      inherits the company time zone.
    </p>
  </div>
</div>

{{> show_flash_messages }}

<div class="row">
  <div class="col-md-12">
    <div class="alert alert-info">
      Time zone order: <strong>work centre</strong> &gt; <strong>company</strong> &gt; <strong>UTC</strong>.
      Company time zone is <strong>{{company_timezone}}</strong>.
      Changing a time zone never changes recorded clock times: entries are stored as
      UTC instants and the zone is only used when displaying them.
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    {{# if centres }}
      <table class="table table-condensed">
        <thead>
          <tr>
            <th>Centre</th>
            <th>Address</th>
            <th style="width: 300px;">Time zone</th>
            <th>Currently using</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{# each centres }}
            <tr>
              <td colspan="5" style="padding: 0; border-top: none;">
                <form action="/settings/workcenters/{{this.id}}/" method="POST" class="form-inline" style="padding: 8px 0;">
                  <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">

                  <div class="form-group" style="width: 22%;">
                    <input type="text" class="form-control" name="name" value="{{this.name}}" required>
                  </div>
                  <div class="form-group" style="width: 22%;">
                    <input type="text" class="form-control" name="address" value="{{this.address}}" placeholder="Address">
                  </div>
                  <div class="form-group" style="width: 28%;">
                    <select class="form-control" name="timezone">
                      <option value="" {{#if_equal this.timezone ''}}selected="selected"{{/if_equal}}>
                        Inherit from company
                      </option>
                      {{# each ../timezones_available }}
                        <option value="{{this}}" {{#if_equal this ../timezone}}selected="selected"{{/if_equal}}>{{this}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class="form-group" style="width: 18%;">
                    <span class="text-muted">{{this.effective}} — {{this.source_label}}</span>
                  </div>
                  <button type="submit" class="btn btn-default">Save</button>
                </form>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{ else }}
      <p class="text-muted">No work centres yet. Add the first one below.</p>
    {{/if}}
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <hr>
    <h3>Add work centre</h3>
    <form action="/settings/workcenters/" method="POST" class="form-inline">
      <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">

      <div class="form-group">
        <label class="sr-only" for="new_name">Name</label>
        <input type="text" class="form-control" id="new_name" name="name" placeholder="Name" required>
      </div>
      <div class="form-group">
        <label class="sr-only" for="new_address">Address</label>
        <input type="text" class="form-control" id="new_address" name="address" placeholder="Address (optional)">
      </div>
      <div class="form-group">
        <label class="sr-only" for="new_timezone">Time zone</label>
        <select class="form-control" id="new_timezone" name="timezone">
          <option value="" selected="selected">Inherit from company</option>
          {{# each timezones_available }}
            <option value="{{this}}">{{this}}</option>
          {{/each}}
        </select>
      </div>
      <button type="submit" class="btn btn-success">Add</button>
    </form>
  </div>
</div>

{{> footer }}
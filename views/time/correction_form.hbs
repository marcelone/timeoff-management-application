{{> header }}

<div class="row">
  <div class="col-md-12">
    <h1>{{type_label}}</h1>
    <p class="lead">
      Times are shown in <strong>{{timezone}}</strong>. Enter the values as they should be.
    </p>
  </div>
</div>

{{> show_flash_messages }}

<div class="row">
  <div class="col-md-12">
    <div class="panel panel-default">
      <div class="panel-heading">New values</div>
      <div class="panel-body">

        <form action="/time/corrections/" method="POST">
          <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">
          <input type="hidden" name="type" value="{{type}}">
          {{# if target }}
            <input type="hidden" name="target" value="{{target}}">
          {{/if}}

          {{# if_equal type "entry_start" }}
            <p class="text-muted">
              New clock-in time. It must be before the clock-out and cannot be in the future.
            </p>
            <div class="form-group">
              <label for="date">Date</label>
              <input type="date" class="form-control" id="date" name="date" value="{{defaults.date}}" required>
            </div>
            <div class="form-group">
              <label for="time">Clock-in time</label>
              <input type="time" class="form-control" id="time" name="time" value="{{defaults.time}}" required>
            </div>
          {{/if_equal}}

          {{# if_equal type "entry_end" }}
            <p class="text-muted">
              New clock-out time. If the session is still open, declaring the clock-out is a
              correction: the declared time becomes the effective end, and the moment you send
              this request is recorded separately.
            </p>
            <div class="form-group">
              <label for="date">Date</label>
              <input type="date" class="form-control" id="date" name="date" value="{{defaults.date}}" required>
            </div>
            <div class="form-group">
              <label for="time">Clock-out time</label>
              <input type="time" class="form-control" id="time" name="time" value="{{defaults.time}}" required>
            </div>
          {{/if_equal}}

          {{# if_equal type "missing_entry" }}
            <p class="text-muted">
              Declare a session that was never clocked. It will be recorded as a
              <strong>declared</strong> session, not as a verified clock-in.
            </p>
            <div class="form-group">
              <label for="date">Date</label>
              <input type="date" class="form-control" id="date" name="date" value="{{defaults.date}}" required>
            </div>
            <div class="form-group">
              <label for="time">Start time</label>
              <input type="time" class="form-control" id="time" name="time" required>
            </div>
            <div class="form-group">
              <label for="end_time">End time</label>
              <input type="time" class="form-control" id="end_time" name="end_time" required>
              <p class="help-block">If the shift crosses midnight, the end belongs to the next day.</p>
            </div>
            <div class="form-group">
              <label for="modality">Work modality</label>
              <select class="form-control" id="modality" name="modality">
                {{# each modalities }}
                  <option value="{{this.value}}">{{this.label}}</option>
                {{/each}}
              </select>
            </div>
          {{/if_equal}}

          {{# if_equal type "break_start" }}
            <p class="text-muted">New break start time. It must stay inside the work session.</p>
            <div class="form-group">
              <label for="date">Date</label>
              <input type="date" class="form-control" id="date" name="date" value="{{defaults.date}}" required>
            </div>
            <div class="form-group">
              <label for="time">Break start</label>
              <input type="time" class="form-control" id="time" name="time" value="{{defaults.time}}" required>
            </div>
          {{/if_equal}}

          {{# if_equal type "break_end" }}
            <p class="text-muted">New break end time. It must stay inside the work session.</p>
            <div class="form-group">
              <label for="date">Date</label>
              <input type="date" class="form-control" id="date" name="date" value="{{defaults.date}}" required>
            </div>
            <div class="form-group">
              <label for="time">Break end</label>
              <input type="time" class="form-control" id="time" name="time" value="{{defaults.time}}" required>
            </div>
          {{/if_equal}}

          {{# if_equal type "break_type" }}
            <p class="text-muted">
              New break type. The criterion used to count this break (whether it counts as worked
              time) is preserved: it is the one that applied when the break happened.
            </p>
            <div class="form-group">
              <label for="break_type">Break type</label>
              <select class="form-control" id="break_type" name="break_type">
                {{# each break_types }}
                  <option value="{{this.value}}" {{# if_equal this.value defaults.break_type}}selected="selected"{{/if_equal}}>{{this.label}}</option>
                {{/each}}
              </select>
            </div>
          {{/if_equal}}

          {{# if_equal type "break_missing" }}
            <p class="text-muted">
              Declare a break that was not recorded. It must be inside the work session and must not
              overlap another break.
            </p>
            <div class="form-group">
              <label for="date">Date</label>
              <input type="date" class="form-control" id="date" name="date" value="{{defaults.date}}" required>
            </div>
            <div class="form-group">
              <label for="time">Break start</label>
              <input type="time" class="form-control" id="time" name="time" required>
            </div>
            <div class="form-group">
              <label for="end_time">Break end</label>
              <input type="time" class="form-control" id="end_time" name="end_time" required>
            </div>
            <div class="form-group">
              <label for="break_type">Break type</label>
              <select class="form-control" id="break_type" name="break_type">
                {{# each break_types }}
                  <option value="{{this.value}}">{{this.label}}</option>
                {{/each}}
              </select>
            </div>
          {{/if_equal}}

          {{# if_equal type "modality" }}
            <p class="text-muted">New work modality. The original one is kept in the audit trail.</p>
            <div class="form-group">
              <label for="modality">Work modality</label>
              <select class="form-control" id="modality" name="modality">
                {{# each modalities }}
                  <option value="{{this.value}}" {{# if_equal this.value defaults.modality}}selected="selected"{{/if_equal}}>{{this.label}}</option>
                {{/each}}
              </select>
            </div>
          {{/if_equal}}

          <div class="form-group">
            <label for="reason">Why is this correction needed?</label>
            <textarea class="form-control" id="reason" name="reason" rows="3" required
                      placeholder="For example: I forgot to clock in when I arrived."></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Send correction request</button>
        </form>
      </div>
    </div>

    <p>
      <a href="/time/corrections/new/{{type}}/" class="btn btn-default">Back</a>
      <a href="/time/corrections/" class="btn btn-default">My corrections</a>
    </p>
  </div>
</div>

{{> footer }}

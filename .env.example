# ---------------------------------------------------------------------------
# TimeOff HR platform - environment configuration (copy to .env and fill in).
# Secrets MUST be provided here / via the orchestrator, never committed.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Session signing secret (REQUIRED in production; generate: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Database: sqlite (default, single-container) or postgres (production option)
DB_DIALECT=sqlite
DB_STORAGE=./db.development.sqlite
# PostgreSQL (used when DB_DIALECT=postgres):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=timeoff
# DB_USER=timeoff
# DB_PASSWORD=change-me
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true  # cert verification ON by default; set false only for self-signed
# DB_SSL_CA=/path/to/ca.pem       # optional CA bundle for TLS

# Optional Redis session store (otherwise sessions are stored in the SQL DB)
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email (SMTP). When SEND_EMAILS=false, emails are logged instead of sent.
SEND_EMAILS=false
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
APPLICATION_SENDER_EMAIL=no-reply@example.com

# Public application domain (used in emails / links)
APPLICATION_DOMAIN=http://localhost:3000

# Allow public self-registration of new companies (admin accounts)
ALLOW_CREATE_NEW_ACCOUNTS=true

# Behind a reverse proxy (Coolify/Traefik): set to true to trust X-Forwarded-*
TRUST_PROXY=false

# Rate limiting (auth endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50

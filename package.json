{
  "name": "timeoff-hr-platform",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Modular HR SaaS platform for SMBs (evolved from TimeOff.Management): employees, absences, allowances, approvals, calendars. Foundation for time-tracking, shifts, documents, employee portal, analytics, payroll integrations and subscriptions.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/wwww",
    "dev": "node --watch bin/wwww",
    "db:migrate": "node scripts/migrate.js",
    "db:generate-initial": "node scripts/generate-initial-migration.js",
    "db:update": "node scripts/migrate.js",
    "carry-over-allowance": "node bin/calculate_carry_over_allowance_for_all_users.js",
    "compile-sass": "sass scss/main.scss public/css/style.css --no-source-map",
    "test": "mocha --recursive t/regression --timeout 60000",
    "test:smoke": "node t/regression/smoke.js",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "connect-redis": "^7.1.1",
    "connect-session-sequelize": "^7.1.7",
    "cookie-parser": "^1.4.7",
    "csv": "^6.3.10",
    "debug": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-handlebars": "^8.0.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "formidable": "^3.5.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "html-to-text": "^9.0.5",
    "ical-generator": "^11.1.3",
    "joi": "^17.13.3",
    "ldapauth-fork": "^6.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "morgan": "^1.10.0",
    "nconf": "^0.12.1",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "passport-local": "^1.0.0",
    "redis": "^4.7.0",
    "sequelize": "^6.37.8",
    "serve-favicon": "^2.5.0",
    "sqlite3": "^5.1.7",
    "umzug": "^3.8.2",
    "underscore": "^1.13.7",
    "uuid": "^11.0.5",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "mocha": "^11.1.0",
    "sass": "^1.83.4",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "graceful-fs": "^4.2.11"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "sqlite3@5.1.7": true,
    "@parcel/watcher@2.6.0": true
  }
}
